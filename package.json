{
  "name": "calorie-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "build:check": "wrangler deploy --dry-run --outdir dist",
    "check": "npm run typecheck && npm run format:check && npm run scan:secrets && npm run test:scripts && npm run test",
    "scan:secrets": "node scripts/secret-scan.mjs",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "import:content": "node scripts/import-content.mjs"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.6",
    "@cloudflare/workers-types": "^5.20261021.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-istanbul": "^4.1.12",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.3"
  }
}
